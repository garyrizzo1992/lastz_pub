<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>Label</key><string>{{ automation_label | e }}</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>{{ automation_data_dir | e }}/run_worker.sh</string></array>
<key>WorkingDirectory</key><string>{{ automation_repo_dir | e }}</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>{{ automation_retry_seconds }}</integer>
<key>StandardOutPath</key><string>{{ automation_data_dir | e }}/logs/worker.stdout.log</string>
<key>StandardErrorPath</key><string>{{ automation_data_dir | e }}/logs/worker.stderr.log</string>
</dict></plist>
